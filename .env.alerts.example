# Copy this file to .env.alerts and fill in your values
# cp .env.alerts.example .env.alerts

# Comma-separated email addresses
ALERT_EMAILS="you@example.com,professor@example.com"

# Discord webhooks — comma-separated
# Supports multiple webhooks for different channels/servers
# Create at: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOKS="https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN"
